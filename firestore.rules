rules_version = '2';
// Règles de sécurité Firestore du TCG JWBnDr.
// Déploiement : automatique sur main (GitHub Actions « Règles Firestore »), ou copier-coller dans
// la console Firebase → Firestore → Règles → Publier.
// Tests : cd tests && npm install && npm test   (émulateur Firebase, Java nécessaire)
//
// ANTI-TRICHE : toute l'économie (pièces, cartes, boosters, displays, Pass, quêtes, statistiques, marché,
// échanges, dons de clan) est calculée par le serveur du jeu (dossier server/, Cloudflare Worker), qui écrit
// avec un compte de service et n'est pas soumis à ces règles. Un joueur ne peut modifier lui-même que son
// pseudo (une fois), ses amis, son clan, sa présence en ligne et ses cadeaux lus.
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FONCTIONS UTILITAIRES ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Champs modifiés par la requête
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function upath(uid) { return /databases/$(database)/documents/users/$(uid); }

    // Dans la liste « field » (ex : friendRequests), je ne peux ajouter ou retirer que MON identifiant
    function onlyMyIdChanges(field) {
      let before = resource.data.get(field, []).toSet();
      let after = request.resource.data.get(field, []).toSet();
      return after.difference(before).hasOnly([request.auth.uid])
          && before.difference(after).hasOnly([request.auth.uid]);
    }

    // AMIS — sur le compte d'un autre joueur, je peux seulement :
    //  - envoyer / retirer ma demande d'ami (friendRequests)
    //  - me retirer de ses amis, ou m'y ajouter si je l'ai déjà mis dans MES amis (demande acceptée)
    function friendUpdate(userId) {
      let addsMeToFriends = request.resource.data.get('friends', []).hasAny([request.auth.uid])
                         && !resource.data.get('friends', []).hasAny([request.auth.uid]);
      return isSignedIn()
          && changedKeys().hasOnly(['friendRequests', 'friends'])
          && (!changedKeys().hasAny(['friendRequests']) || onlyMyIdChanges('friendRequests'))
          && (!changedKeys().hasAny(['friends']) || onlyMyIdChanges('friends'))
          && (!addsMeToFriends
              || get(upath(request.auth.uid)).data.get('friends', []).hasAny([userId]));
    }

    // Mon compte : seulement ces champs, jamais l'économie
    function ownUpdateValid() {
      let b = resource.data;
      let a = request.resource.data;
      return changedKeys().hasOnly(['pseudo', 'pseudoChanged', 'lastOnline', 'giftInbox', 'friends', 'friendRequests', 'clanId'])
        // Pseudo : une seule fois, 3 à 20 caractères
        && (!changedKeys().hasAny(['pseudo', 'pseudoChanged'])
            || (b.get('pseudoChanged', false) != true && a.get('pseudoChanged', false) == true
                && a.pseudo is string && a.pseudo.size() >= 3 && a.pseudo.size() <= 20))
        && (!changedKeys().hasAny(['lastOnline']) || a.lastOnline == request.time)
        // Cadeaux reçus : on ne peut que les retirer (les objets sont donnés par le serveur)
        && (!changedKeys().hasAny(['giftInbox']) || b.get('giftInbox', []).toSet().hasAll(a.get('giftInbox', [])))
        && (!changedKeys().hasAny(['clanId']) || !('clanId' in a) || a.clanId is string);
    }

    // Nouveau compte : 50 pièces maximum, rien d'autre
    function zeroInventory(m) { return m.keys().size() == 0 || m.values().hasOnly([0]); }
    function newUserValid(d) {
      return d.get('coins', 0) is int && d.get('coins', 0) >= 0 && d.get('coins', 0) <= 50
        && d.get('collection', {}).size() == 0
        && zeroInventory(d.get('boosterInventory', {})) && zeroInventory(d.get('displayInventory', {}))
        && d.get('battlePass', {}).get('xp', 0) == 0 && d.get('battlePass', {}).get('claimedRewards', {}).size() == 0
        && d.get('dailyBoosterOpenedCount', 0) == 0 && d.get('dailyV2BoosterOpenedCount', 0) == 0
        && !d.keys().hasAny(['econ', 'lastDeal', 'achievements', 'packsBought', 'giftCalendar', 'clanId', 'friends', 'shop', 'stats', 'pseudoChanged']);
    }

    // Échanges entre amis : les offres et « prêt » sont écrits par les joueurs, la validation par le serveur
    function offerValid(o) {
      return o is map && o.keys().hasOnly(['cards', 'coins', 'boosters'])
        && o.coins is int && o.coins >= 0 && o.cards is map && o.cards.size() <= 10 && o.boosters is map;
    }
    function tradeUpdateValid() {
      let b = resource.data;
      let a = request.resource.data;
      let isA = request.auth.uid == b.from;
      return false
        // Je change mon offre : les deux joueurs doivent revalider
        || (b.status == 'accepted' && a.status == 'accepted' && changedKeys().hasOnly([isA ? 'offerA' : 'offerB', 'readyA', 'readyB'])
          && a.readyA == false && a.readyB == false && offerValid(isA ? a.offerA : a.offerB))
        // Je suis prêt
        || (b.status == 'accepted' && changedKeys().hasOnly([isA ? 'readyA' : 'readyB']) && (isA ? a.readyA : a.readyB) == true)
        // L'invité accepte ou refuse
        || (b.status == 'pending' && !isA && changedKeys().hasOnly(['status']) && (a.status == 'accepted' || a.status == 'refused'))
        // Expiré ou annulé
        || ((b.status == 'pending' || b.status == 'accepted') && changedKeys().hasOnly(['status'])
          && (a.status == 'expired' || a.status == 'canceled'));
    }

    // --- RÈGLES PAR COLLECTION ---

    // 1. UTILISATEURS
    match /users/{userId} {
      // Lecture par tout joueur connecté (pseudo d'un vendeur, profil d'un ami…)
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && newUserValid(request.resource.data);
      allow update: if (isOwner(userId) && ownUpdateValid()) || (!isOwner(userId) && friendUpdate(userId));
      allow delete: if false;
    }

    // 2. HÔTEL DES VENTES : lecture seulement (annonces, mises, achats et clôtures par le serveur)
    match /auctions/{auctionId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /auctions/{auctionId}/bids/{bidId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 3. ÉCHANGES ENTRE AMIS
    match /tradeRequests/{tradeId} {
      allow read: if isSignedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.from == request.auth.uid
        && request.resource.data.keys().hasOnly(['from', 'to', 'status', 'createdAt', 'offerA', 'offerB', 'readyA', 'readyB'])
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.readyA == false && request.resource.data.readyB == false
        && offerValid(request.resource.data.offerA) && offerValid(request.resource.data.offerB)
        && get(upath(request.auth.uid)).data.get('friends', []).hasAny([request.resource.data.to]);
      allow update: if isSignedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid)
        && !changedKeys().hasAny(['from', 'to', 'createdAt'])
        && tradeUpdateValid();
    }

    // 4. CHAT GÉNÉRAL — lecture par les joueurs connectés ; un message = mon identifiant, mon vrai pseudo,
    //    1 à 200 caractères, horodaté par le serveur. Ni modification ni suppression.
    match /chat/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid', 'pseudo', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
        && request.resource.data.createdAt == request.time
        && request.resource.data.pseudo == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pseudo;
    }

    // 5. CLANS — chacun ne peut ajouter ou retirer que lui-même (et son compte suit dans le même lot) ;
    //    le chef modifie la description, exclut des membres, ou passe la main en partant.
    function clanFieldsValid() {
      let d = request.resource.data;
      return d.name is string && d.name.size() >= 3 && d.name.size() <= 24
          && d.tag is string && d.tag.matches('^[A-Z0-9]{2,4}$')
          && d.description is string && d.description.size() <= 120
          && d.get('emblem', '') is string && d.get('emblem', '').size() <= 4
          && d.members is list && d.members.size() <= 20;
    }
    function myClanIdAfter() {
      return getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('clanId', '');
    }
    function isClanMember(clanId) {
      return get(/databases/$(database)/documents/clans/$(clanId)).data.members.hasAny([request.auth.uid]);
    }
    match /clans/{clanId} {
      allow read: if isSignedIn();
      // Création : par le serveur (elle coûte des pièces)
      allow create: if false;
      allow update: if isSignedIn() && clanFieldsValid() && (
        // Rejoindre / quitter : seulement moi
        (changedKeys().hasOnly(['members']) && onlyMyIdChanges('members')
          && ((request.resource.data.members.hasAny([request.auth.uid]) && myClanIdAfter() == clanId)
              || (!request.resource.data.members.hasAny([request.auth.uid]) && myClanIdAfter() != clanId)))
        // Le chef part : il se retire et donne le clan à un membre restant
        || (resource.data.ownerId == request.auth.uid && changedKeys().hasOnly(['members', 'ownerId'])
          && resource.data.members.toSet().difference(request.resource.data.members.toSet()).hasOnly([request.auth.uid])
          && request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0
          && request.resource.data.members.hasAny([request.resource.data.ownerId])
          && myClanIdAfter() != clanId)
        // Le chef : description et exclusions (retirer des membres, jamais en ajouter, jamais lui-même)
        || (resource.data.ownerId == request.auth.uid && changedKeys().hasOnly(['description', 'members'])
          && request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0
          && request.resource.data.members.hasAny([request.auth.uid]))
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid && resource.data.members.size() <= 1;

      // Demandes de cartes et dons : par le serveur (les dons rapportent des pièces)
      match /requests/{requestId} {
        allow read: if isSignedIn() && isClanMember(clanId);
        allow write: if false;
      }

      // Chat du clan : réservé aux membres
      match /messages/{messageId} {
        allow read: if isSignedIn() && isClanMember(clanId);
        allow create: if isSignedIn() && isClanMember(clanId)
          && request.resource.data.keys().hasOnly(['uid', 'pseudo', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
          && request.resource.data.createdAt == request.time
          && request.resource.data.pseudo == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pseudo;
      }
    }

    // 6. TOUT LE RESTE : interdit
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
