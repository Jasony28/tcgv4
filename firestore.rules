rules_version = '2';
// Règles de sécurité Firestore du TCG JWBnDr.
// Déploiement : firebase deploy --only firestore:rules   (ou copier-coller dans la console Firebase → Firestore → Règles)
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FONCTIONS UTILITAIRES ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Champs modifiés par la requête
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Dans la liste « field » (ex : friendRequests), je ne peux ajouter ou retirer que MON identifiant
    function onlyMyIdChanges(field) {
      let before = resource.data.get(field, []).toSet();
      let after = request.resource.data.get(field, []).toSet();
      return after.difference(before).hasOnly([request.auth.uid])
          && before.difference(after).hasOnly([request.auth.uid]);
    }

    // AMIS — sur le compte d'un autre joueur, je peux seulement :
    //  - envoyer / retirer ma demande d'ami (friendRequests)
    //  - me retirer de ses amis, ou m'y ajouter si je l'ai déjà mis dans MES amis (demande acceptée)
    function friendUpdate(userId) {
      let addsMeToFriends = request.resource.data.get('friends', []).hasAny([request.auth.uid])
                         && !resource.data.get('friends', []).hasAny([request.auth.uid]);
      return isSignedIn()
          && changedKeys().hasOnly(['friendRequests', 'friends'])
          && (!changedKeys().hasAny(['friendRequests']) || onlyMyIdChanges('friendRequests'))
          && (!changedKeys().hasAny(['friends']) || onlyMyIdChanges('friends'))
          && (!addsMeToFriends
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('friends', []).hasAny([userId]));
    }

    // HÔTEL DES VENTES / ÉCHANGES — l'économie d'un autre joueur (pièces, cartes, boosters, displays,
    // stats) ne peut changer que pendant une affaire entre lui et moi, modifiée dans la même transaction.
    // Le jeu indique l'affaire dans le champ lastDeal : { kind: 'auction' | 'trade', id }.
    function dealUpdate(userId) {
      let deal = request.resource.data.get('lastDeal', {});
      return isSignedIn()
          && changedKeys().hasOnly(['coins', 'collection', 'boosterInventory', 'displayInventory', 'stats', 'lastDeal'])
          && deal is map
          && deal.get('id', '') is string && deal.get('id', '') != ''
          && (auctionDeal(deal, userId) || tradeDeal(deal, userId) || clanRequestDeal(deal, userId));
    }

    // Enchère / annonce d'échange : il était vendeur ou meilleur enchérisseur, j'y participe après la
    // transaction (vendeur, nouvel enchérisseur ou acheteur), et l'annonce change en même temps.
    function auctionDeal(deal, userId) {
      let path = /databases/$(database)/documents/auctions/$(deal.id);
      let before = get(path).data;
      let after = getAfter(path).data;
      return deal.kind == 'auction'
          && before.status == 'active'
          && after != before
          && [before.sellerId, before.get('highestBidderId', '')].hasAny([userId])
          && [after.sellerId, after.get('highestBidderId', ''), after.get('buyerId', '')].hasAny([request.auth.uid]);
    }

    // Don de carte dans un clan : il est l'auteur de la demande, et j'y ajoute mon don en même temps
    function clanRequestDeal(deal, userId) {
      let path = /databases/$(database)/documents/clans/$(deal.clan)/requests/$(deal.id);
      let before = get(path).data;
      let after = getAfter(path).data;
      return deal.kind == 'clanRequest'
          && before.uid == userId && request.auth.uid != userId
          && after.received == before.received + 1
          && after.donors.get(request.auth.uid, 0) == before.donors.get(request.auth.uid, 0) + 1;
    }

    // Échange entre amis : nous sommes les deux participants et il passe à « completed » maintenant
    function tradeDeal(deal, userId) {
      let path = /databases/$(database)/documents/tradeRequests/$(deal.id);
      let before = get(path).data;
      let after = getAfter(path).data;
      return deal.kind == 'trade'
          && before.status != 'completed'
          && after.status == 'completed'
          && [before.from, before.to].hasAll([request.auth.uid, userId]);
    }

    // --- RÈGLES PAR COLLECTION ---

    // 1. UTILISATEURS
    match /users/{userId} {
      // Lecture par tout joueur connecté (pseudo d'un vendeur, profil d'un ami…)
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      // Mon compte : librement. Le compte d'un autre : seulement amis ou affaire en cours entre nous.
      allow update: if isOwner(userId) || friendUpdate(userId) || dealUpdate(userId);
      allow delete: if false;
    }

    // 2. ENCHÈRES (Hôtel des Ventes)
    match /auctions/{auctionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn();
    }
    match /auctions/{auctionId}/bids/{bidId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.bidderId == request.auth.uid;
    }

    // 3. ÉCHANGES ENTRE AMIS
    match /tradeRequests/{tradeId} {
      allow read: if isSignedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.from == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // 4. CHAT GÉNÉRAL — lecture par les joueurs connectés ; un message = mon identifiant, mon vrai pseudo,
    //    1 à 200 caractères, horodaté par le serveur. Ni modification ni suppression.
    match /chat/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid', 'pseudo', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
        && request.resource.data.createdAt == request.time
        && request.resource.data.pseudo == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pseudo;
    }

    // 5. CLANS — chacun ne peut ajouter ou retirer que lui-même (et son compte suit dans le même lot) ;
    //    le chef modifie la description, exclut des membres, ou passe la main en partant.
    function clanFieldsValid() {
      let d = request.resource.data;
      return d.name is string && d.name.size() >= 3 && d.name.size() <= 24
          && d.tag is string && d.tag.matches('^[A-Z0-9]{2,4}$')
          && d.description is string && d.description.size() <= 120
          && d.get('emblem', '') is string && d.get('emblem', '').size() <= 4
          && d.members is list && d.members.size() <= 20;
    }
    function myClanIdAfter() {
      return getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('clanId', '');
    }
    function isClanMember(clanId) {
      return get(/databases/$(database)/documents/clans/$(clanId)).data.members.hasAny([request.auth.uid]);
    }
    match /clans/{clanId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['name', 'tag', 'description', 'emblem', 'ownerId', 'members', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.createdAt == request.time
        && clanFieldsValid()
        && myClanIdAfter() == clanId;
      allow update: if isSignedIn() && clanFieldsValid() && (
        // Rejoindre / quitter : seulement moi
        (changedKeys().hasOnly(['members']) && onlyMyIdChanges('members')
          && ((request.resource.data.members.hasAny([request.auth.uid]) && myClanIdAfter() == clanId)
              || (!request.resource.data.members.hasAny([request.auth.uid]) && myClanIdAfter() != clanId)))
        // Le chef part : il se retire et donne le clan à un membre restant
        || (resource.data.ownerId == request.auth.uid && changedKeys().hasOnly(['members', 'ownerId'])
          && resource.data.members.toSet().difference(request.resource.data.members.toSet()).hasOnly([request.auth.uid])
          && request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0
          && request.resource.data.members.hasAny([request.resource.data.ownerId])
          && myClanIdAfter() != clanId)
        // Le chef : description et exclusions (retirer des membres, jamais en ajouter, jamais lui-même)
        || (resource.data.ownerId == request.auth.uid && changedKeys().hasOnly(['description', 'members'])
          && request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0
          && request.resource.data.members.hasAny([request.auth.uid]))
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid && resource.data.members.size() <= 1;

      // Demandes de cartes : 1 demande à la fois par joueur (au moins 6 h d'écart, le jeu limite à 1 par jour).
      // Un don = +1 reçu, mon compteur de dons +1, et je perds vraiment un exemplaire de la carte.
      match /requests/{requestId} {
        allow read: if isSignedIn() && isClanMember(clanId);
        allow create: if isSignedIn() && isClanMember(clanId)
          && request.resource.data.keys().hasOnly(['uid', 'pseudo', 'cardId', 'needed', 'received', 'donors', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.cardId is string
          && request.resource.data.needed is int && request.resource.data.needed >= 1 && request.resource.data.needed <= 4
          && request.resource.data.received == 0 && request.resource.data.donors == {}
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastClanRequestAt == request.time
          && (!('lastClanRequestAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
              || request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastClanRequestAt + duration.value(6, 'h'));
        allow update: if isSignedIn() && isClanMember(clanId) && request.auth.uid != resource.data.uid
          && changedKeys().hasOnly(['received', 'donors'])
          && request.resource.data.received == resource.data.received + 1
          && request.resource.data.received <= resource.data.needed
          && request.resource.data.donors.diff(resource.data.donors).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.donors.get(request.auth.uid, 0) == resource.data.donors.get(request.auth.uid, 0) + 1
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.collection[resource.data.cardId].quantity
             == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.collection[resource.data.cardId].quantity - 1;
      }

      // Chat du clan : réservé aux membres
      match /messages/{messageId} {
        allow read: if isSignedIn() && isClanMember(clanId);
        allow create: if isSignedIn() && isClanMember(clanId)
          && request.resource.data.keys().hasOnly(['uid', 'pseudo', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
          && request.resource.data.createdAt == request.time
          && request.resource.data.pseudo == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pseudo;
      }
    }

    // 6. TOUT LE RESTE : interdit
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
